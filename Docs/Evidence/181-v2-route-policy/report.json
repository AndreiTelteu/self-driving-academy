  "scenarios": [
    {
      "name": "ponderea timpului",
      "scenario": "două coridoare reale între aceeași origine și destinație: `route-short` (scurt, 5 m/s) și `route-fast` (lung, 22 m/s), ambele cu exact un viraj perceput"
    },
    {
      "name": "ponderea distanței",
      "scenario": "aceleași două coridoare, cu preferința de distanță testată la extrem"
    },
    {
      "name": "penalizarea virajelor",
      "scenario": "două coridoare cu geometrie identică și același timp liber, dar cu 4, respectiv 1 viraj declarat de proprietarul hărții"
    },
    {
      "name": "penalizarea semafoarelor",
      "scenario": "aceleași două coridoare simetrice, cu 3, respectiv 0 semafoare declarate pe traseu"
    },
    {
      "name": "penalizarea congestiei",
      "scenario": "aceleași două coridoare simetrice, cu întârzierea reală de congestie pe `route-north` (10 s de trafic declarat pe fiecare din cele două benzi) și 0 s pe `route-south`"
    },
    {
      "name": "răbdarea la rerutare",
      "scenario": "ruta curentă `route-slow` este dominată în toate dimensiunile de `route-direct`, iar alternativa mai bună a fost văzută de 60 de tick-uri"
    },
    {
      "name": "disponibilitatea întoarcerii în U",
      "scenario": "ruta directă (`route-direct`, 10 m/s) față de o rută care cere o întoarcere în U către o arteră de 20 m/s, cu harta declarând întoarcerea permisă"
    },
    {
      "name": "durata recuperării prin marșarier",
      "scenario": "recuperare prin marșarier cerută de lume, cu spațiul din spate declarat liber: durata commitată a manevrei"
    }
  ],
