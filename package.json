{
  "name": "self-driving-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"tests/**/*.html\" \"scripts/**/*.mjs\" \"*.{json,js,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"tests/**/*.html\" \"scripts/**/*.mjs\" \"*.{json,js,html}\"",
    "check:architecture": "node scripts/verify-architecture.mjs",
    "generate:parameter-catalog": "node scripts/generate-parameter-catalog.mjs",
    "check:parameter-catalog": "node scripts/generate-parameter-catalog.mjs --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:architecture && npm test",
    "test": "node --import ./scripts/register-typescript.mjs --test \"tests/**/*.test.ts\"",
    "test:domain": "node --import ./scripts/register-typescript.mjs --test \"tests/harness/*.test.ts\"",
    "test:isolated": "node scripts/run-isolated-tests.mjs",
    "scenarios:autonomy": "node --import ./scripts/register-typescript.mjs scripts/run-auto-scenarios.mjs",
    "fleet:registry": "node --import ./scripts/register-typescript.mjs scripts/run-fleet-registry-report.mjs",
    "civil:traffic": "node --import ./scripts/register-typescript.mjs scripts/run-civil-traffic-report.mjs",
    "ride:demand": "node --import ./scripts/register-typescript.mjs scripts/run-ride-demand-report.mjs",
    "ride:lifecycle": "node --import ./scripts/register-typescript.mjs scripts/run-ride-fsm-report.mjs",
    "ride:pickup": "node --import ./scripts/register-typescript.mjs scripts/run-pickup-report.mjs",
    "ride:dropoff": "node --import ./scripts/register-typescript.mjs scripts/run-dropoff-report.mjs",
    "ride:eta": "node --import ./scripts/register-typescript.mjs scripts/run-eta-report.mjs",
    "fleet:dispatch": "node --import ./scripts/register-typescript.mjs scripts/run-dispatcher-report.mjs",
    "fleet:health": "node --import ./scripts/register-typescript.mjs scripts/run-fleet-health-report.mjs",
    "trip:manual": "node --import ./scripts/register-typescript.mjs scripts/run-manual-trip-report.mjs",
    "hud:taxi": "node --import ./scripts/register-typescript.mjs scripts/run-taxi-hud-report.mjs",
    "hud:minimap": "node --import ./scripts/register-typescript.mjs scripts/run-minimap-report.mjs",
    "passenger:visual": "node --import ./scripts/register-typescript.mjs scripts/run-passenger-visual-report.mjs",
    "fleet:panel": "node --import ./scripts/register-typescript.mjs scripts/run-fleet-panel-report.mjs",
    "city:dashboard": "node --import ./scripts/register-typescript.mjs scripts/run-city-dashboard-report.mjs",
    "metrics:service": "node --import ./scripts/register-typescript.mjs scripts/run-metric-service-report.mjs",
    "metrics:behavior": "node --import ./scripts/register-typescript.mjs scripts/run-behavior-metrics-report.mjs",
    "profile:panel": "node --import ./scripts/register-typescript.mjs scripts/run-profile-panel-report.mjs",
    "profile:history": "node --import ./scripts/register-typescript.mjs scripts/run-profile-history-report.mjs",
    "profile:activate": "node --import ./scripts/register-typescript.mjs scripts/run-profile-activation-report.mjs",
    "profile:continuity": "node --import ./scripts/register-typescript.mjs scripts/run-profile-continuity-report.mjs",
    "profile:pipeline": "node --import ./scripts/register-typescript.mjs scripts/run-profile-pipeline-report.mjs",
    "profile:ui-binding": "node --import ./scripts/register-typescript.mjs scripts/run-profile-ui-binding-report.mjs",
    "learning:notifications": "node --import ./scripts/register-typescript.mjs scripts/run-learning-notifications-report.mjs",
    "learning:explanation": "node --import ./scripts/register-typescript.mjs scripts/run-learning-explanation-report.mjs",
    "learning:inverse": "node --import ./scripts/register-typescript.mjs scripts/run-inverse-learning-report.mjs",
    "learning:cross-class": "node --import ./scripts/register-typescript.mjs scripts/run-cross-class-fidelity-report.mjs",
    "learning:edgecases": "node --import ./scripts/register-typescript.mjs scripts/run-learning-edgecases-report.mjs",
    "learning:gate24": "node --import ./scripts/register-typescript.mjs scripts/run-learning-gate24-report.mjs",
    "learning:epoch": "node --import ./scripts/register-typescript.mjs scripts/run-learning-epoch-report.mjs",
    "key:remapping": "node --import ./scripts/register-typescript.mjs scripts/run-key-remapping-report.mjs",
    "game:settings": "node --import ./scripts/register-typescript.mjs scripts/run-game-settings-report.mjs",
    "map:selection": "node --import ./scripts/register-typescript.mjs scripts/run-map-selection-report.mjs",
    "ui:accessibility": "node --import ./scripts/register-typescript.mjs scripts/run-ui-accessibility-report.mjs",
    "ui:responsive": "node --import ./scripts/register-typescript.mjs scripts/run-responsive-layout-report.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.29.0",
    "@babylonjs/loaders": "9.29.0",
    "@dimforge/rapier3d-compat": "0.21.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/eslint-parser": "8.0.6",
    "@babylonjs/inspector": "9.29.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
